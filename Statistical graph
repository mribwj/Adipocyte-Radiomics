#KM curve
data <- read.csv(".csv")

#data$group <- factor(data$group, levels = c(0, 1), labels = c("Favorable", "Unfavorable"))


surv_object <- Surv(time = data$TimeOS, event = data$StatusOS)


fit <- survfit(surv_object ~ s11, data = data)  


plot <- ggsurvplot(
  fit,
  data = data,
  legend.title = "RS",
  legend.labs= c("low","high"),
  font.x = 14,font.y = 14,font.legend = 12,font.tickslab = 12, font.title = 12, 
  pval = FALSE,                 
  pval.method = TRUE,           
  conf.int = FALSE,              
  risk.table = TRUE,
  risk.table.x.text.size = 14,
  risk.table.fontsize=4,
  xlab = "Time(months)", 
  ylab = "Survival probability",
  palette= c("#000080","#FF0000")
)

p_value <- surv_pvalue(fit, data = data)$pval 
if (p_value < 0.001) {
  p_value_label <- "italic(p) < 0.001" 
} else {
  p_value_label <- paste0("italic(p) == ", format(p_value, digits = 3, scientific = FALSE)) # 否则显示正常的 p 值
}


plot$plot <- plot$plot + 
  annotate(
    "text",
    x = max(data$TimeOS) * 0.1, 
    y = 0.1,
    label = p_value_label,
    parse = TRUE,
    size = 4
  )

print(plot)



