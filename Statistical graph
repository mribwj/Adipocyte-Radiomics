# violin plot

# Read  data
data2 <- read.csv(".csv")

data2$label <- factor(data2$label, levels = c(0, 1), labels = c("negative", "positive"))

# Perform Wilcoxon test 
wilcox_test_valid <- wilcox.test(s1 ~ label, data = data2)

# Create violin plot 
p3 <- ggplot(data2, aes(x = label, y = s1, fill = label, color = label)) +
  geom_violin(trim = FALSE, fill = "transparent") +  # Hollow violin plot
  geom_boxplot(width = 0.1, fill = "white") +  # Boxplot with white fill
  labs(
    title = paste(" Set - Wilcoxon, p =", format(wilcox_test_valid$p.value, scientific = TRUE)),
    x = "Adipocyte phenotypes",
    y = "Radiomics score"
  ) +
  scale_color_manual(values = c("negative" = "#FF0000", "positive" = "#000080")) +  # Border colors
  scale_y_continuous(
    breaks = c(0, 0.4, 0.8),  # Set ticks at 0, 0.4, 0.8
    limits = c(-0.2, 1)  # Force y-axis display range
  ) +
  theme_minimal()  # Use minimal theme to avoid distractions

print(p3)
