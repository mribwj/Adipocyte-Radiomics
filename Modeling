# ICC
setwd("file")

#### Input features from two observers (A and B) ####
feature_A_all <- read.csv("observer1.csv", header = T, check.names = F, row.names = 1); dim(feature_A_all)
head(feature_A_all)
feature_B <- read.csv("observer2.csv", header = T, check.names = F, row.names = 1); dim(feature_B)
head(feature_B)

#### Identify commonly segmented samples ####
co_A_B = intersect(row.names(feature_A_all), row.names(feature_B)); co_A_B; length(co_A_B)

#### Prepare data for ICC calculation: feature_A, feature_B ####
feature_A = feature_A_all[co_A_B,]; dim(feature_A)
feature_B = feature_B[co_A_B,]; dim(feature_B)

#### Calculate ICC for a single feature (using the 100th feature) ####
colnames(feature_A)[100]

feature_AB <- cbind(feature_A[, 100], feature_B[, 100]); head(feature_AB)

Icc <- icc(feature_AB, model = "twoway", type = "agreement", 
           unit = "single", r0 = 0, conf.level = 0.95); Icc

#### Batch calculation of ICC values ####
# Create an empty matrix to store calculated values
# Determine the number of features
len <- length(feature_A)
# Create a row with length equal to the number of features, with feature names as column names
Iccs <- matrix(nrow = 1, ncol = len, dimnames = list('value', colnames(feature_B))) 
# Use for loop to combine and calculate
for (i in 1:len) {
  feature_AB <- cbind(feature_A[, i], feature_B[, i])
  Icc <- icc(feature_AB, model = "twoway", type = "agreement", 
             unit = "single", r0 = 0, conf.level = 0.95)
  Iccs[i] <- Icc$value   
}
# View ICC results
Iccs

#### ICC evaluation ####
# Set high_cutoff and low_cutoff
high_cutoff = 0.75; low_cutoff = 0.5
# Create a new empty matrix
char_vector_rownames <- c('Value')
char_vector_colnames <- c(paste0('ICC≥', high_cutoff),
                        paste0(low_cutoff, '≤ICC<', high_cutoff), 
                        paste0('ICC<', low_cutoff), 
                        'ICC_Mean', 
                        'ICC_Median')
ICC_all <- matrix(nrow = 1, ncol = 5, dimnames = list(char_vector_rownames, char_vector_colnames)) 
ICC_all

# Start calculation, count features in three intervals
h <- length(which(Iccs > high_cutoff))
ICC_all[1, 1] <- h
print(paste('Number of features with ICC ≥', high_cutoff, ':')); print(h)

m <- length(which(Iccs >= low_cutoff)) - length(which(Iccs > high_cutoff)) 
ICC_all[1, 2] <- m
print(paste('Number of features with ICC between', low_cutoff, 'and', high_cutoff, ':')); print(m)

l <- length(which(Iccs < low_cutoff))
ICC_all[1, 3] <- l
print(paste('Number of features with ICC <', low_cutoff, ':')); print(l)

# Calculate mean and median
print('ICC mean:'); print(mean(Iccs))
ICC_all[1, 4] <- mean(Iccs)
print('ICC median:'); print(median(Iccs))
ICC_all[1, 5] <- median(Iccs)

ICC_all

#### Select features with ICC above cutoff ####
Index <- which(Iccs >= high_cutoff); Index
feature <- feature_A_all[, Index]; dim(feature)
feature

