#### Prepare data for ICC calculation: feature_A, feature_B ####
feature_A = feature_A_all[co_A_B,]; dim(feature_A)
feature_B = feature_B[co_A_B,]; dim(feature_B)

#### Calculate ICC for a single feature (using the 100th feature) ####
colnames(feature_A)[100]

feature_AB <- cbind(feature_A[, 100], feature_B[, 100]); head(feature_AB)

Icc <- icc(feature_AB, model = "twoway", type = "agreement", 
           unit = "single", r0 = 0, conf.level = 0.95); Icc

#### Batch calculation of ICC values ####
# Create an empty matrix to store calculated values
# Determine the number of features
len <- length(feature_A)
# Create a row with length equal to the number of features, with feature names as column names
Iccs <- matrix(nrow = 1, ncol = len, dimnames = list('value', colnames(feature_B))) 
# Use for loop to combine and calculate
for (i in 1:len) {
  feature_AB <- cbind(feature_A[, i], feature_B[, i])
  Icc <- icc(feature_AB, model = "twoway", type = "agreement", 
             unit = "single", r0 = 0, conf.level = 0.95)
  Iccs[i] <- Icc$value   
}
# View ICC results
Iccs

#### ICC evaluation ####
# Set high_cutoff and low_cutoff
high_cutoff = 0.75; low_cutoff = 0.5
# Create a new empty matrix
char_vector_rownames <- c('Value')
