                        paste0(low_cutoff, '≤ICC<', high_cutoff), 
                        paste0('ICC<', low_cutoff), 
                        'ICC_Mean', 
                        'ICC_Median')
ICC_all <- matrix(nrow = 1, ncol = 5, dimnames = list(char_vector_rownames, char_vector_colnames)) 
ICC_all

