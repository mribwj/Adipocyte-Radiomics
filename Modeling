# Read data
df_all <- read.csv(".csv") 
# Ensure label column is factor type, suitable for binomial family in glmnet
df_all$label <- as.factor(df_all$label)

results <- data.frame(seed = integer(), feature_count = integer(), train_auc = numeric(), valid_auc = numeric())





# seed
for (seed in 1:300) {
  set.seed(seed)
  
 # Split dataset
  indices <- sample(1:nrow(df_all), size = floor(0.7 * nrow(df_all)))
  training_set <- df_all[indices, ]
  validation_set <- df_all[-indices, ]
  
  # Univariate analysis
  p_values <- sapply(names(df_all)[!names(df_all) %in% c("label", "Name")], function(feature_name) {
    feature_data <- training_set[[feature_name]]
    
    # Skip features with all identical values
    if (length(unique(feature_data)) == 1) {
      return(NA)  # Return NA to skip this feature
    }

    # Check normality and perform T-test or Mann-Whitney U test
    if (shapiro.test(feature_data)$p.value > 0.05) {
      test_result <- t.test(feature_data ~ training_set$label)
    } else {
      group_0 <- feature_data[training_set$label == levels(training_set$label)[1]]
      group_1 <- feature_data[training_set$label == levels(training_set$label)[2]]
      test_result <- wilcox.test(group_0, group_1)
    }
    return(test_result$p.value)
  })
  
  # Filter features with significance level < 0.05 and not NA
  significant_features <- names(df_all)[!names(df_all) %in% c("label", "Name")][!is.na(p_values) & p_values < 0.05]
  
  # Prepare training data
  x_train <- model.matrix(~ . -1 - label - Name, data = training_set[, c(significant_features, "label", "Name"), drop = FALSE])
  
  
  # If feature matrix has less than 2 columns, write NA and skip this iteration
  if (ncol(x_train) < 2) {
    results <- rbind(results, data.frame(seed = seed, feature_count = NA, train_auc = NA, valid_auc = NA))
    next
  }
  
  y_train <- training_set$label
  
  # Use cross-validation to find the best lambda value
  cv_fit <- cv.glmnet(x_train, y_train, family = "binomial", type.measure = "auc", alpha = 1)
  best_lambda <- cv_fit$lambda.1se
  
  # Retrain model based on best lambda
  fit <- glmnet(x_train, y_train, family = "binomial", lambda = best_lambda, alpha = 1)
  
  # Get non-zero coefficient features after LASSO
  lasso_selected_features <- rownames(coef(fit, s = best_lambda))[coef(fit, s = best_lambda)[, 1] != 0]
  lasso_selected_features <- lasso_selected_features[!lasso_selected_features %in% "(Intercept)"]
  feature_count <- length(lasso_selected_features)
  
  # Prepare validation dataset
  x_validation <- model.matrix(~ . -1 - label - Name, data = validation_set[, c(significant_features, "label", "Name"), drop = FALSE])
  y_validation <- validation_set$label
  
  # AUC
  train_predictions <- predict(fit, newx = x_train, s = best_lambda, type = "response")
  valid_predictions <- predict(fit, newx = x_validation, s = best_lambda, type = "response")
  
  train_auc <- roc(y_train, train_predictions)$auc
  valid_auc <- roc(y_validation, valid_predictions)$auc
  
 
  results <- rbind(results, data.frame(seed = seed, feature_count = feature_count, train_auc = train_auc, valid_auc = valid_auc))
}

write.csv(results, ".csv", row.names = FALSE)



